{
  // Environnement du Codespace : rien à installer pour le prof.
  // Image « universal » = image par défaut de Codespaces : aucune construction, démarrage rapide,
  // et elle ne compte pas dans le stockage gratuit. Pas de « features » : elles forcent une construction.
  "name": "Mon site (niveau 1 — GitHub Pages)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "anthropic.claude-code",
        "mistralai.mistral-vibe-code"
      ],
      "settings": {
        "workbench.startupEditor": "none",
        "files.autoSave": "afterDelay"
      }
    },
    "codespaces": {
      // Fichier ouvert automatiquement à l'arrivée.
      "openFiles": ["AGENTS.md"]
    }
  },
  // Lance l'aperçu du site à chaque ouverture du Codespace.
  "postAttachCommand": "python3 -m http.server 5173",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Aperçu de mon site", "onAutoForward": "openPreview" }
  }
}
